# Template of the application's settings. Copy to `.env` on your computer; never commit `.env`.
# Agents may read and edit this file, never `.env`.
PORT=8000

# OpenAI-compatible endpoint for vision/LLM backends (homelab LiteLLM gateway, Ollama or vLLM).
# Example for the homelab gateway: http://<gateway-host>:4000/v1
MMO_OPENAI_BASE_URL=
# Key for that endpoint (a LiteLLM virtual key); leave empty when the endpoint needs none.
MMO_OPENAI_API_KEY=
# Model name as the endpoint knows it, used by `mmo ocr run --backend openai` when --model is not given.
MMO_OCR_MODEL=
# Request timeout in seconds (large local models can be slow per page).
MMO_OPENAI_TIMEOUT=600

# Tesseract backend
MMO_TESSERACT_CMD=tesseract
MMO_TESSERACT_LANG=ces
